# Healthy Diet Recommendation System Configuration

# Application
APP_NAME="HealthyDiet"
APP_TITLE="Healthy Diet Recommendation — Personalized Nutrition & Meal Planning"
APP_ENV="development"
APP_URL="http://localhost:8080"
APP_DEBUG=true

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=healthy_diet_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=86400
CSRF_TOKEN_SECRET="healthy-diet-super-secret-key-change-in-prod"
ADMIN_EMAIL="admin@healthydiet.com"

# Upload Limits
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/jpg"
